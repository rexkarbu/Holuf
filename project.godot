; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="HOLUF"
config/description="A dark fantasy 2D turn-based RPG"
run/main_scene="res://scenes/main/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

DialogueManager="*res://scripts/core/dialogue_manager.gd"
QuestManager="*res://scripts/quest/quest_manager.gd"
StoryManager="*res://scripts/story/story_manager.gd"
GameManager="*res://scripts/core/game_manager.gd"
TransitionManager="*res://scenes/autoload/transition_manager.tscn"
SettingsManager="*res://scripts/core/settings_manager.gd"
PartyManager="*res://scripts/party/party_manager.gd"
InventoryManager="*res://scripts/core/inventory_manager.gd"
EquipmentManager="*res://scripts/core/equipment_manager.gd"
EncounterManager="*res://scripts/world/encounter_manager.gd"
BattleSpeed="*res://scripts/core/battle_speed.gd"
SaveManager="*res://scripts/core/save_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

